# Non-secret host settings. Copy outside this repository before editing.
# baseline.py only renders/validates; it never starts containers.
COMPOSE_PROJECT_NAME=risklive-prod
RISKLIVE_DATA_DIR=/opt/risklive/data
APP_ENV_FILE=/opt/risklive/data/env/app.env
WEB_ENV_FILE=/opt/risklive/data/env/web.env
CADDY_ENV_FILE=/opt/risklive/data/env/caddy.env
APP_IMAGE=risklive-app:8a6775ac9a5c
WEB_IMAGE=risklive-web:8a42195ba06d
CADDY_HTTP_BIND=0.0.0.0:8888
RISKLIVE_PRODUCTION_CHECKOUT=/home/azureuser/risklive-dev/.worktrees/seca-v2-release
RISKLIVE_CADDY_CHECKOUT=/home/azureuser/risklive-dev
RISKLIVE_CADDY_FILE=/home/azureuser/risklive-dev/deployment/caddy/Caddyfile.prod
RISKLIVE_DEVELOPMENT_CHECKOUT=/home/azureuser/risklive-on-demand-dev
RISKLIVE_DEV_DATA_DIR=/opt/risklive/dev-data
RISKLIVE_DEV_IMAGE_TAG=local
